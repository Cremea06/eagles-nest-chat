# Copy to .env locally. Never commit .env.

PORT=3000

XAI_API_KEY=
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# CHG-047 — keep members signed in for 30 days. Generate with: openssl rand -hex 32
# Blank (or under 32 chars) turns the feature off and chat works as before.
MEMBER_TOKEN_SECRET=
# Set to 1 only to print /auth codes in the server log (e.g. while SMTP is down). Off by default.
AUTH_CODE_LOG=
# CHG-058: optional: replaces the built-in edit-mode code. Put the SHA-256 (64 hex chars) of the new code,
# lowercased and trimmed, e.g.: node -e "console.log(require('crypto').createHash('sha256').update('newcode'.trim().toLowerCase()).digest('hex'))"
# Blank keeps the built-in code. A value that is not 64 hex chars is ignored (warning in the log).
EDIT_MODE_CODE_SHA256=
