# Copy to .env locally. Never commit .env.

PORT=3000

XAI_API_KEY=
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# CHG-047 — keep members signed in for 30 days. Generate with: openssl rand -hex 32
# Blank (or under 32 chars) turns the feature off and chat works as before.
MEMBER_TOKEN_SECRET=
# Set to 1 only to print /auth codes in the server log (e.g. while SMTP is down). Off by default.
AUTH_CODE_LOG=
# CHG-058: optional: replaces the built-in edit-mode code. Put the SHA-256 (64 hex chars) of the new code,
# lowercased and trimmed, e.g.: node -e "console.log(require('crypto').createHash('sha256').update('newcode'.trim().toLowerCase()).digest('hex'))"
# Blank keeps the built-in code. A value that is not 64 hex chars is ignored (warning in the log).
EDIT_MODE_CODE_SHA256=
# CHG-133: Tailgate Party override. Generate with: openssl rand -hex 32  (blank/under 16 chars = POST /api/tailgate off).
TAILGATE_TOKEN=
# CHG-133: set to 0 to stop the 2-minute Rumble live check (manual override still works).
TAILGATE_POLL=
# CHG-133: when auto mode may ask Rumble. Default 'Mon-Fri 21:00-22:00' in America/New_York (DST-safe). Outside it: no Rumble
# requests and auto = normal, except a show found live inside the window keeps being checked every 2 min until it ends
# (max 3 h past window end). Days Sun..Sat with ranges/commas, times HH:MM 24 h, same-day only. Bad value -> default.
TAILGATE_WINDOW=
# Optional IANA zone for TAILGATE_WINDOW (default America/New_York).
TAILGATE_TZ=
# CHG-134: Clips. Blank = everyone (guests and members) can clip and upvote. Set to 1 = members only.
CLIPS_MEMBERS_ONLY=
# CHG-134: optional admin token to hide/delete any clip (DELETE /api/clips/ID). Blank = TAILGATE_TOKEN is used. Under 16 chars = off.
CLIPS_ADMIN_TOKEN=
