# Copy to .env locally. Never commit .env.

PORT=3000

XAI_API_KEY=
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# CHG-047 — keep members signed in for 30 days. Generate with: openssl rand -hex 32
# Blank (or under 32 chars) turns the feature off and chat works as before.
MEMBER_TOKEN_SECRET=
# Set to 1 only to print /auth codes in the server log (e.g. while SMTP is down). Off by default.
AUTH_CODE_LOG=
